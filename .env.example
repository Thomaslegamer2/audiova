# Adresse publique du site (sitemap / liens). Exemple Webgune :
# NEXT_PUBLIC_SITE_URL=https://audiova.webgune.dev
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Adresse affichée sur /contact uniquement si renseignée.
NEXT_PUBLIC_CONTACT_EMAIL=

# Publicités : laisser false tant que la config admin / AdSense n'est pas validée.
NEXT_PUBLIC_ADS_ENABLED=false
# Optionnel — client / slot Google AdSense (emplacement discret hors convertisseur).
# NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-xxxxxxxx
# NEXT_PUBLIC_ADSENSE_SLOT=xxxxxxxxxx
# Lien de don (Ko-fi / Buy Me a Coffee) — bouton « Offrir un café » dans le pied de page.
# NEXT_PUBLIC_DONATE_URL=https://ko-fi.com/votre-page

# --- Administration (/av-ctl) — OBLIGATOIRE ---
# Un seul réglage suffit pour se connecter (≥ 8 caractères).
ADMIN_PASSWORD=

# Optionnel (≥ 32 caractères). Si vide, dérivé automatiquement du mot de passe.
# ADMIN_SESSION_SECRET=
