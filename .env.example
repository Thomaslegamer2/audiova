# Adresse publique du site (sitemap, robots, canonical).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Adresse affichée sur /contact uniquement si renseignée.
NEXT_PUBLIC_CONTACT_EMAIL=

# Publicités : laisser false tant que la config admin / AdSense n'est pas validée.
NEXT_PUBLIC_ADS_ENABLED=false

# --- Administration (/av-ctl) — OBLIGATOIRE ---
# Mot de passe fort (≥ 12 caractères). Ne jamais committer la vraie valeur.
ADMIN_PASSWORD=

# Secret de signature des sessions admin (≥ 32 caractères aléatoires).
# Génération possible : openssl rand -hex 32
ADMIN_SESSION_SECRET=

# --- Omnaworks Control (optionnel) ---
# Branche l'agent heartbeat / thèmes partagés. Laisser vide = admin local seul.
# OW_CONTROL_URL=https://control.audiova.site
# OW_SITE_KEY=ow_live_...
# OW_CONFIG_AUTHORITY=hub

